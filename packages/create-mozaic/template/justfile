# Common tasks. Install just: https://just.systems

# Run the data pipeline (R and Python scripts) to refresh data/processed/
data:
    Rscript analysis/R/01_prepare.R
    # uv run analysis/py/prepare.py

# Preview every chart at http://localhost:5173
dev:
    pnpm dev

# Type-check the charts
check:
    pnpm check

# Build static embeds into build/
build:
    pnpm build

# Export SVG, PDF and PNG files into exports/ (needs a Chromium)
export: build
    pnpm export

# Everything: data, build, export
all: data build export
