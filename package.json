{
	"name": "mozaic-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.15.0",
	"scripts": {
		"dev": "pnpm --filter docs dev",
		"build": "pnpm --filter mozaic package && pnpm --filter docs build",
		"check": "pnpm -r check",
		"test": "pnpm -r test",
		"test:e2e": "pnpm --filter docs test:e2e",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"export": "pnpm --filter docs export",
		"changeset": "changeset",
		"release": "changeset version",
		"release:publish": "changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^2.29.0",
		"@eslint/js": "^10.0.1",
		"eslint": "^10.13.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0"
	},
	"engines": {
		"node": ">=22.17"
	}
}
